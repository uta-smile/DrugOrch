# Copy to .env and fill in. .env is gitignored.

# --- which model makes the routing decisions ---------------------------------
# anthropic | openai | chatgpt.  "chatgpt" signs in with ChatGPT and bills decisions to
# your own Plus/Pro plan, so it needs no key at all. Switchable in the web interface.
# DRUGORCH_LLM_PROVIDER=anthropic

# Only for the LLM routing policy; every rule-based policy runs without any credential.
# A key can also be entered in the web interface, which needs no restart.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# DRUGORCH_VINA_EXE=tools/vina.exe
# DRUGORCH_DATA_DIR=data
# DRUGORCH_OFFLINE=false
# DRUGORCH_LLM_MODEL=claude-opus-5-5
# DRUGORCH_OPENAI_MODEL=gpt-5.1
# DRUGORCH_LLM_EFFORT=medium
